# Placeholder values only. Supply real values through the deployment platform or a
# secret manager. Nothing loads this file automatically; see README "Configuration".

# Required. SQLAlchemy URLs using the PyMySQL driver. Add TLS parameters when the
# database is reached over a network, e.g. ?ssl_ca=/etc/ssl/certs/db-ca.pem
# The baseball database also holds api_user, api_access_group_endpoint_map,
# api_user_status and api_request_log.
RAZZBALL_BASEBALL_DATABASE_URL=mysql+pymysql://razzball_api_ro:CHANGE_ME@db.example.internal/razzball_wp2012
RAZZBALL_BASKETBALL_DATABASE_URL=mysql+pymysql://razzball_api_ro:CHANGE_ME@db.example.internal/razzball_basketball
RAZZBALL_FOOTBALL_DATABASE_URL=mysql+pymysql://razzball_api_ro:CHANGE_ME@db.example.internal/razzball_football

# Optional (defaults shown).
RAZZBALL_TRUSTED_HOSTS=api.razzball.com
RAZZBALL_PROXY_COUNT=0
RAZZBALL_TIMEZONE=America/New_York
RAZZBALL_LOG_LEVEL=INFO
RAZZBALL_LOG_REQUESTS_TO_DATABASE=true
RAZZBALL_MAX_ROWS=20000
